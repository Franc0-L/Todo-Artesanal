# Plantilla de `.env.local` — frontend Vite. Este archivo SÍ va a git;
# el real `.env.local` está gitignored (*.local) y se crea con:
#
#   npm run env:init     # lo crea desde esta plantilla si falta
#   npm run env:cloud    # (re)escribe -> proyecto en la nube
#   npm run env:local    # (re)escribe -> stack local de Docker
#
# Los valores de acá abajo son los de la nube y deben mantenerse sincronizados
# con la constante CLOUD de scripts/switch-env.mjs (fuente de verdad de
# `npm run env:cloud`). La publishable key es un valor PÚBLICO: va en el
# bundle del browser y ya está commiteada en ese script.
#
# Detalle y checklist de migración de máquina: docs/entorno-y-secretos.md

VITE_SUPABASE_URL=https://zarvihhrzfcvlegqygnu.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_oXj8-cX7Nd1KEnyKLpZ5kg_nExCU3yr

# Stack local (npm run env:local reescribe el archivo con esto):
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=PUBLISHABLE_KEY de `npx supabase status -o env`
